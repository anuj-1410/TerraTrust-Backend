# Firebase Authentication
FIREBASE_PROJECT_ID=[firebase-project-id]

# Supabase
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=[service_role_key]
DATABASE_URL=postgresql+asyncpg://postgres:[db-password]@[host]:5432/postgres
# Supabase Database Settings > SSL Configuration > server root certificate.
# For an untrusted/self-signed chain, upload it as Render secret supabase-ca.crt
# and set DATABASE_SSL_CA_FILE=/etc/secrets/supabase-ca.crt. Otherwise leave blank.
DATABASE_SSL_CA_FILE=

# Google credentials via local files or Render secret files
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
GEE_PROJECT_ID=[gee-cloud-project-id]
GEE_CREDENTIALS_PATH=./secrets/gee-service-account.json
CLOUD_VISION_CREDENTIALS_PATH=./secrets/cloud-vision-service-account.json

# Legacy shared Google fallback (optional, only for older local setups)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# NASA NISAR
NASA_EARTHDATA_USERNAME=[username]
NASA_EARTHDATA_PASSWORD=[password]
NISAR_GEE_ASSET_ID=users/terratrust/nisar
NISAR_GEE_ASSET_TYPE=image_collection
NISAR_HH_BAND=HH
NISAR_HV_BAND=HV

# Blockchain
ADMIN_WALLET_PRIVATE_KEY=[private key]
ADMIN_WALLET_ADDRESS=[public address]
ALCHEMY_POLYGON_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/[key]
CONTRACT_ADDRESS=[deployed contract address]

# IPFS
PINATA_JWT=[jwt]
PINATA_GATEWAY_URL=[your-gateway].mypinata.cloud

# PolygonScan
POLYGONSCAN_API_KEY=[key]

# Government APIs
LGD_API_BASE=http://115.124.105.220/API  # Maharashtra LGD API base URL

# App Config
ENVIRONMENT=development        # or production
WEB_CORS_ORIGINS=http://localhost:8081    # Optional comma-separated web origins
REDIS_URL=redis://localhost:6379/0   # Update to cloud Redis URL for production (rediss:// for Upstash)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# Farmer accounts 001-004 only; independent of institution demos. False in production.
ENABLE_FARMER_DEMO_ACCOUNTS=false

# Institution activation: enable schema only after migrations; business flags last.
# Render uses its own environment values; editing this file or local .env does not update it.
# Set both schema/flow flags true to enable registration for real and demo users.
INSTITUTION_SCHEMA_ENABLED=false
ENABLE_INSTITUTION_FLOW=false
ENABLE_INSTITUTION_ADVISOR=false
# Values live in Supabase calculation/source tables; receipt key is a local file.
# Follow INSTITUTION_MANUAL_WORK.md; no model/method/corpus UUID env values.

# Optional in development and production. If supplied, use public HTTPS URLs.
INSTITUTION_PRIVACY_POLICY_URL=
INSTITUTION_SUPPORT_URL=
INSTITUTION_ACCOUNT_DELETION_URL=

# Licensed Unicode TTF mounted on export workers; its actual SHA-256.
INSTITUTION_REPORT_FONT_PATH=
INSTITUTION_REPORT_FONT_SHA256=

# Optional free Gemini advisor: server key and available model IDs.
# PDFs/corpus are managed through institution_knowledge_sources, not env UUIDs.
GEMINI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=0

# Institution accounts 5-9: same DATABASE_URL, tables, buckets and real services.
# Built-in SYNTHETIC starting samples + in-process login markers; no demo tables.
# Optional captured private checkpoints override the built-in samples.
# Independent of farmer demos; enable only for local institution testing.
ENABLE_INSTITUTION_DEMO_ACCOUNTS=false
# Rename legacy ENABLE_DEMO_ACCOUNTS to ENABLE_FARMER_DEMO_ACCOUNTS.
# Remove legacy AUDIT_DEMO_MODE from backend .env; it no longer enables demos.

# Fixed limits/provider selection live in app/institution_config.py.
# Bucket names, Gemini data handling and retrieval rules live in code.
# NISAR reuses the existing shared NISAR_GEE_ASSET_* and HH/HV band settings.
